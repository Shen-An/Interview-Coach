# ===== LLM 配置（推荐在应用「设置」里填写；也可复制本文件为 .env 手改）=====
# 提供商：anthropic 或 openai
LLM_PROVIDER=anthropic

# --- Anthropic（Claude Messages API）---
# 用中转站时填 ANTHROPIC_BASE_URL（不带 /v1，如 https://api.xxx.com），key 填中转站的
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=

# --- OpenAI（优先 Responses API，网关不支持时自动降级 chat/completions）---
# 用中转站时填 OPENAI_BASE_URL（带 /v1，如 https://api.xxx.com/v1）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=

# --- 响应速度（可选；read 是流式相邻数据块的最大空闲时间，不是总回答时长） ---
# IC_LLM_CONNECT_TIMEOUT=8
# IC_LLM_READ_TIMEOUT=45
# IC_LLM_WRITE_TIMEOUT=20
# IC_LLM_POOL_TIMEOUT=8
# QA_MAX_OUTPUT_TOKENS=3200

# --- 语音转写（exe/Electron 版必需；浏览器版可不填，走免费 Web Speech API）---
# 不填 STT_* 时复用上方 OPENAI_API_KEY / OPENAI_BASE_URL
# 任何 whisper 兼容接口都可以；国内推荐硅基流动（注册送额度）：
#   STT_BASE_URL=https://api.siliconflow.cn/v1
#   STT_MODEL=FunAudioLLM/SenseVoiceSmall   （免费）
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=gpt-4o-mini-transcribe

# --- 面试官语音合成（可选；全留空 = 微软 Edge 免费云端男声「云希」，无需 key）---
# 换免费男声：TTS_VOICE=zh-CN-YunjianNeural（低沉）/ zh-CN-YunyangNeural（播音腔）
# OpenAI 官方/中转站：TTS_MODEL=gpt-4o-mini-tts TTS_VOICE=onyx
# 硅基流动：TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:benjamin
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=onyx
