# ---- 密钥：绝对不能进仓库 ----
.env
.env.local
*.key

# ---- 构建产物（1.8G，且单个安装包超过 GitHub 100MB 限制）----
dist-electron/
dist-backend/
build-pyi/*
!build-pyi/*.spec
node_modules/
build-venv/
*.exe
*.blockmap

# ---- 运行时生成的用户数据 ----
sessions/
resume.txt
resume.meta.json
*.log

# kb/ 的三层情报（raw 原文 / compiled 编译产物 / UPDATES.md 渲染视图）是进仓库的：
# 它们既是这个项目的知识库语料，也随安装包发给新机器。只挡掉迁移和运行时留下的备份。
kb/UPDATES.md.bak
kb/UPDATES.md.pre-migrate-*

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- 本地工具配置（不是项目的一部分）----
.claude/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
